[
  {
    "name": "theme_info",
    "theme_name": "Sevolf",
    "theme_version": "1.0.0",
    "theme_author": "Sevolf",
    "theme_documentation_url": "https://sevolf.com",
    "theme_support_url": "https://sevolf.com"
  },
  {
    "name": "General",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo image"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 50,
        "max": 250,
        "step": 5,
        "unit": "px",
        "label": "Custom logo width",
        "default": 120
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon image",
        "info": "Will be scaled down to 32 x 32px"
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_bg",
        "label": "Background",
        "default": "#FAF8F5"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Surface / Card Background",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Primary Text",
        "default": "#141413"
      },
      {
        "type": "color",
        "id": "color_text_muted",
        "label": "Muted / Secondary Text",
        "default": "#686663"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Borders & Dividers",
        "default": "#E6E2DC"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent Color",
        "default": "#2D312E"
      },
      {
        "type": "color",
        "id": "color_button_bg",
        "label": "Primary Button Background",
        "default": "#141413"
      },
      {
        "type": "color",
        "id": "color_button_text",
        "label": "Primary Button Text",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_badge_sale",
        "label": "Sale Badge Background",
        "default": "#D9534F"
      },
      {
        "type": "color",
        "id": "color_badge_digital",
        "label": "Digital Badge Background",
        "default": "#1A4731"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_header_font",
        "label": "Heading font",
        "default": "sans-serif"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Body font",
        "default": "sans-serif"
      },
      {
        "type": "range",
        "id": "heading_scale",
        "min": 90,
        "max": 130,
        "step": 5,
        "unit": "%",
        "label": "Heading scale",
        "default": 100
      }
    ]
  },
  {
    "name": "Layout & Styling",
    "settings": [
      {
        "type": "range",
        "id": "page_max_width",
        "min": 1000,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "label": "Maximum page width",
        "default": 1400
      },
      {
        "type": "range",
        "id": "border_radius",
        "min": 0,
        "max": 24,
        "step": 2,
        "unit": "px",
        "label": "Card & Button Border Radius",
        "default": 0
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Cart type",
        "options": [
          {
            "value": "drawer",
            "label": "Drawer"
          },
          {
            "value": "page",
            "label": "Page"
          }
        ],
        "default": "drawer"
      },
      {
        "type": "checkbox",
        "id": "show_cart_note",
        "label": "Enable order notes",
        "default": true
      },
      {
        "type": "text",
        "id": "free_shipping_threshold",
        "label": "Free shipping minimum amount (optional)",
        "info": "Example: 1500 for ₹1,500 or $50"
      }
    ]
  },
  {
    "name": "Social Media",
    "settings": [
      {
        "type": "text",
        "id": "social_instagram_link",
        "label": "Instagram link"
      },
      {
        "type": "text",
        "id": "social_twitter_link",
        "label": "X (Twitter) link"
      },
      {
        "type": "text",
        "id": "social_pinterest_link",
        "label": "Pinterest link"
      },
      {
        "type": "text",
        "id": "social_youtube_link",
        "label": "YouTube link"
      }
    ]
  }
]
