{%- if section.settings.show_announcement -%}
  <aside
    class="announcement-bar{% unless section.settings.show_on_mobile %} announcement-bar--hide-mobile{% endunless %}{% unless section.settings.show_on_desktop %} announcement-bar--hide-desktop{% endunless %}"
    style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};"
    aria-label="Announcement"
  >
    <div class="container announcement-bar__inner">
      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}" class="announcement-bar__link" style="color: {{ section.settings.text_color }};">
          {{ section.settings.text }}
        </a>
      {%- else -%}
        <span class="announcement-bar__text">{{ section.settings.text }}</span>
      {%- endif -%}
    </div>
  </aside>
{%- endif -%}

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show announcement",
      "default": true
    },
    {
      "type": "text",
      "id": "text",
      "label": "Announcement text",
      "default": "COMPLIMENTARY STANDARD SHIPPING"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link (optional)"
    },
    {
      "type": "checkbox",
      "id": "show_on_desktop",
      "label": "Show on desktop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_on_mobile",
      "label": "Show on mobile",
      "default": true
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#141413"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FAF8F5"
    }
  ]
}
{% endschema %}

