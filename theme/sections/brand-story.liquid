<section class="section-spacing" style="background-color: #F3EFEA; border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border);">
  <div class="container container--narrow" style="text-align: center;">
    <span style="display: block; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.15em; color: var(--color-text-muted); margin-bottom: 1rem; font-weight: 700;">
      {{ section.settings.subheading }}
    </span>
    <h2 style="font-size: clamp(1.8rem, 4vw, 2.75rem); line-height: 1.25; margin-bottom: 1.5rem;">
      {{ section.settings.heading }}
    </h2>
    <p style="font-size: 1.05rem; line-height: 1.8; color: var(--color-text-muted); margin-bottom: 2rem;">
      {{ section.settings.text }}
    </p>
    {%- if section.settings.link_label != blank -%}
      <a href="{{ section.settings.link_url }}" class="btn btn--outline">
        {{ section.settings.link_label }}
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Brand Story",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Our Philosophy"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Bridging physical essentials with deliberate digital architecture."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Sevolf was founded on the principle that modern living demands both tangible craftsmanship and seamless digital utility. Every apparel silhouette, accessory, and digital workspace is engineered to reduce friction and elevate daily focus."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link Label",
      "default": "Discover Our Story"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    }
  ],
  "presets": [
    {
      "name": "Brand Story"
    }
  ]
}
{% endschema %}
