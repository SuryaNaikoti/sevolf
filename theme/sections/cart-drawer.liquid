<div class="cart-drawer-overlay" data-cart-drawer-overlay></div>

<div class="cart-drawer" data-cart-drawer role="dialog" aria-modal="true" aria-label="Shopping Bag">
  <div class="cart-drawer__header">
    <h3 style="font-size: 1.25rem; font-weight: 700;">{{ 'cart.title' | t }}</h3>
    <button type="button" class="action-btn" data-cart-drawer-close aria-label="{{ 'general.close' | t }}">
      {% render 'icon', icon: 'close' %}
    </button>
  </div>

  <div class="cart-drawer__items" data-cart-drawer-items>
    {%- if cart.item_count == 0 -%}
      <div style="text-align: center; padding: 4rem 1rem; color: var(--color-text-muted);">
        <p style="font-size: 1rem; margin-bottom: 1.5rem;">{{ 'cart.empty' | t }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn--outline" data-cart-drawer-close>
          {{ 'cart.continue_shopping' | t }}
        </a>
      </div>
    {%- else -%}
      {%- for item in cart.items -%}
        <div class="cart-drawer__item" data-line-item-key="{{ item.key }}">
          {%- if item.image -%}
            <img
              class="cart-drawer__item-img"
              src="{{ item.image | image_url: width: 150 }}"
              alt="{{ item.title | escape }}"
              width="72"
              height="90"
              loading="lazy"
            >
          {%- endif -%}
          <div class="cart-drawer__item-info">
            <h4>{{ item.product.title }}</h4>
            {%- unless item.product.has_only_default_variant -%}
              <p class="cart-drawer__item-variant">{{ item.variant.title }}</p>
            {%- endunless -%}
            <div style="display:flex; justify-content:space-between; align-items:center; margin-top: 0.5rem;">
              <div class="cart-drawer__quantity">
                <button type="button" class="cart-drawer__qty-btn" onclick="updateCartLine('{{ item.key }}', {{ item.quantity | minus: 1 }})">-</button>
                <span class="cart-drawer__qty-num">{{ item.quantity }}</span>
                <button type="button" class="cart-drawer__qty-btn" onclick="updateCartLine('{{ item.key }}', {{ item.quantity | plus: 1 }})">+</button>
              </div>
              <strong>{{ item.final_line_price | money }}</strong>
            </div>
          </div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>

  <div class="cart-drawer__footer">
    <div class="cart-drawer__subtotal">
      <span>{{ 'cart.subtotal' | t }}</span>
      <span data-cart-drawer-subtotal>{{ cart.total_price | money }}</span>
    </div>
    <p class="cart-drawer__note">
      {{ 'cart.taxes_and_shipping_policy_at_checkout_html' | t }}
    </p>
    <a href="/checkout" class="btn btn--full" style="padding: 1rem;">
      {{ 'cart.checkout' | t }} &rarr;
    </a>
  </div>
</div>

{% schema %}
{
  "name": "Cart Drawer",
  "settings": []
}
{% endschema %}
