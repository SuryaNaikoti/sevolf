<section class="section-spacing" style="padding-top: 0;">
  <div class="container">
    <div class="digital-showcase">
      <div class="digital-showcase__grid">
        <div>
          <span class="badge badge--digital" style="margin-bottom: 1rem;">
            {% render 'icon', icon: 'download' %} Dedicated Digital Architecture
          </span>
          <h2 style="color: #FFFFFF; margin-bottom: 1.25rem;">
            {{ section.settings.heading }}
          </h2>
          <p style="color: #C7C2B8; font-size: 1.05rem; line-height: 1.7; margin-bottom: 2rem;">
            {{ section.settings.text }}
          </p>

          <div class="digital-feature-list">
            <div class="digital-feature-item">
              <h4>Instant Delivery</h4>
              <p>Direct electronic access granted immediately upon successful checkout.</p>
            </div>
            <div class="digital-feature-item">
              <h4>Zero Shipping Friction</h4>
              <p>No addresses or freight fees required for digital assets.</p>
            </div>
            <div class="digital-feature-item">
              <h4>Multi-Format Kits</h4>
              <p>Includes Notion workspaces, printable templates, and digital assets.</p>
            </div>
            <div class="digital-feature-item">
              <h4>Commercial License</h4>
              <p>Ready for personal use, client projects, and commercial workflows.</p>
            </div>
          </div>

          <div style="margin-top: 2.5rem;">
            <a href="{{ section.settings.button_link }}" class="btn btn--white">
              {{ section.settings.button_label }}
            </a>
          </div>
        </div>

        <div>
          {%- if section.settings.image != blank -%}
            <img
              src="{{ section.settings.image | image_url: width: 800 }}"
              alt="{{ section.settings.heading | escape }}"
              style="border-radius: var(--radius); width: 100%; border: 1px solid rgba(255,255,255,0.15);"
              loading="lazy"
              width="800"
              height="600"
            >
          {%- else -%}
            <div style="aspect-ratio: 4/3; background: rgba(255,255,255,0.06); border: 1px dashed rgba(255,255,255,0.2); border-radius: var(--radius); display: flex; align-items: center; justify-content: center; color: #8F8B82; font-weight: 600;">
              DIGITAL WORKSPACE DEMO
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Digital Ecosystem",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Modern digital tools designed for focus & clarity."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "From meticulously engineered Notion workspaces and digital planners to comprehensive design resources—Sevolf empowers your creative routine."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Visual Asset"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Explore Digital Collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Digital Ecosystem"
    }
  ]
}
{% endschema %}
