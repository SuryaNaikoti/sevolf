<section class="hero-banner" style="min-height: {{ section.settings.height }}vh;">
  {%- if section.settings.image != blank -%}
    <img
      src="{{ section.settings.image | image_url: width: 2000 }}"
      alt="{{ section.settings.heading | escape }}"
      class="hero-banner__media"
      loading="eager"
      width="2000"
      height="1200"
    >
  {%- endif -%}

  <div class="container">
    <div class="hero-banner__content">
      {%- if section.settings.subheading != blank -%}
        <div class="hero-banner__subheading">
          {{ section.settings.subheading }}
        </div>
      {%- endif -%}

      <h1 class="hero-banner__title">
        {{ section.settings.heading }}
      </h1>

      {%- if section.settings.text != blank -%}
        <p class="hero-banner__text">
          {{ section.settings.text }}
        </p>
      {%- endif -%}

      <div class="hero-banner__buttons">
        {%- if section.settings.primary_button_label != blank -%}
          <a href="{{ section.settings.primary_button_link }}" class="btn btn--white">
            {{ section.settings.primary_button_label }}
          </a>
        {%- endif -%}

        {%- if section.settings.secondary_button_label != blank -%}
          <a href="{{ section.settings.secondary_button_link }}" class="btn btn--outline" style="color: #FFFFFF; border-color: rgba(255,255,255,0.4);">
            {{ section.settings.secondary_button_label }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "range",
      "id": "height",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Section height",
      "default": 80
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Independent Contemporary Label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Made for the way you live."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "Carefully engineered essentials and purpose-built digital assets designed for creators, thinkers, and modern lifestyles."
    },
    {
      "type": "text",
      "id": "primary_button_label",
      "label": "Primary button label",
      "default": "Shop Collection"
    },
    {
      "type": "url",
      "id": "primary_button_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secondary button label",
      "default": "Explore Digital Assets"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Secondary button link"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
