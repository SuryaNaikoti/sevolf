<section class="section-spacing">
  <div class="container container--narrow">
    <div class="account-card" data-scroll-reveal>
      <div class="account-card__header">
        <h1 class="account-card__title">{{ 'customer.login.title' | t }}</h1>
        <p class="account-card__subtitle">{{ 'customer.login.subtitle' | t }}</p>
      </div>

      {%- form 'customer_login' -%}
        {{ form.errors | default_errors }}

        <div class="form-field">
          <label for="CustomerEmail" class="form-label">{{ 'customer.login.email' | t }}</label>
          <input
            type="email"
            id="CustomerEmail"
            name="customer[email]"
            autocomplete="email"
            autocapitalize="off"
            required
            class="form-input"
            placeholder="you@example.com"
          >
        </div>

        <div class="form-field">
          <label for="CustomerPassword" class="form-label">{{ 'customer.login.password' | t }}</label>
          <input
            type="password"
            id="CustomerPassword"
            name="customer[password]"
            autocomplete="current-password"
            required
            class="form-input"
            placeholder="••••••••"
          >
        </div>

        <div class="form-field">
          <button type="submit" class="btn btn--full">{{ 'customer.login.sign_in' | t }}</button>
        </div>

        <div class="account-card__links">
          <a href="{{ routes.account_recover_url }}" class="account-link">{{ 'customer.login.forgot_password' | t }}</a>
        </div>
      {%- endform -%}

      <div class="account-card__divider">
        <span>{{ 'general.or' | t }}</span>
      </div>

      <div class="account-card__footer">
        <p class="account-card__footer-text">{{ 'customer.login.no_account' | t }}</p>
        <a href="{{ routes.account_register_url }}" class="btn btn--outline btn--full">{{ 'customer.login.create_account' | t }}</a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Customer Login",
  "settings": []
}
{% endschema %}
