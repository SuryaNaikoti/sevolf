<section class="section-spacing">
  <div class="container container--narrow">
    <div class="account-card" data-scroll-reveal>
      <div class="account-card__header">
        <h1 class="account-card__title">{{ 'customer.register.title' | t }}</h1>
        <p class="account-card__subtitle">{{ 'customer.register.subtitle' | t }}</p>
      </div>

      {%- form 'create_customer' -%}
        {{ form.errors | default_errors }}

        <div class="form-row form-row--half">
          <div class="form-field">
            <label for="FirstName" class="form-label">{{ 'customer.register.first_name' | t }}</label>
            <input
              type="text"
              id="FirstName"
              name="customer[first_name]"
              autocomplete="given-name"
              required
              class="form-input"
            >
          </div>
          <div class="form-field">
            <label for="LastName" class="form-label">{{ 'customer.register.last_name' | t }}</label>
            <input
              type="text"
              id="LastName"
              name="customer[last_name]"
              autocomplete="family-name"
              required
              class="form-input"
            >
          </div>
        </div>

        <div class="form-field">
          <label for="Email" class="form-label">{{ 'customer.register.email' | t }}</label>
          <input
            type="email"
            id="Email"
            name="customer[email]"
            autocomplete="email"
            autocapitalize="off"
            required
            class="form-input"
            placeholder="you@example.com"
          >
        </div>

        <div class="form-field">
          <label for="CreatePassword" class="form-label">{{ 'customer.register.password' | t }}</label>
          <input
            type="password"
            id="CreatePassword"
            name="customer[password]"
            autocomplete="new-password"
            required
            class="form-input"
            placeholder="Minimum 5 characters"
          >
        </div>

        <div class="form-field">
          <button type="submit" class="btn btn--full">{{ 'customer.register.create' | t }}</button>
        </div>
      {%- endform -%}

      <div class="account-card__divider">
        <span>{{ 'general.or' | t }}</span>
      </div>

      <div class="account-card__footer">
        <p class="account-card__footer-text">{{ 'customer.register.has_account' | t }}</p>
        <a href="{{ routes.account_login_url }}" class="btn btn--outline btn--full">{{ 'customer.register.sign_in' | t }}</a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Customer Register",
  "settings": []
}
{% endschema %}
