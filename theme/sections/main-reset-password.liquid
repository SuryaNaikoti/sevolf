<section class="section-spacing">
  <div class="container container--narrow">
    <div class="account-card" data-scroll-reveal>
      <div class="account-card__header">
        <h1 class="account-card__title">{{ 'customer.reset_password.title' | t }}</h1>
        <p class="account-card__subtitle">{{ 'customer.reset_password.subtitle' | t }}</p>
      </div>

      {%- form 'recover_customer_password' -%}
        {{ form.errors | default_errors }}

        {%- if form.posted_successfully? -%}
          <div class="form-success-message">
            <p>{{ 'customer.reset_password.success' | t }}</p>
          </div>
        {%- endif -%}

        <div class="form-field">
          <label for="RecoverEmail" class="form-label">{{ 'customer.reset_password.email' | t }}</label>
          <input
            type="email"
            id="RecoverEmail"
            name="email"
            autocomplete="email"
            autocapitalize="off"
            required
            class="form-input"
            placeholder="you@example.com"
          >
        </div>

        <div class="form-field">
          <button type="submit" class="btn btn--full">{{ 'customer.reset_password.submit' | t }}</button>
        </div>

        <div class="account-card__links">
          <a href="{{ routes.account_login_url }}" class="account-link">&larr; {{ 'customer.reset_password.back_to_login' | t }}</a>
        </div>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Password Reset",
  "settings": []
}
{% endschema %}
