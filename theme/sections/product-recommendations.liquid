{% comment %}
  Product recommendations section using Shopify's native recommendation engine with intelligent collection/type fallback.
  Renders as a horizontal editorial carousel with staggered scroll animations.
{% endcomment %}

<div
  class="product-recommendations section-spacing"
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit=6"
  data-recommendations-section
>
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="container">
      <div class="recommendations__header" data-recommendations-header>
        <div>
          <span class="recommendations__subheading">ARCHIVE SELECTION</span>
          <h2 class="recommendations__title">{{ section.settings.heading | default: 'YOU MAY ALSO LIKE' | upcase }}</h2>
        </div>
        <div class="recommendations__controls">
          <button type="button" class="rec-carousel-btn rec-carousel-btn--prev" data-rec-prev aria-label="Previous products">
            {% render 'icon', icon: 'arrow-left' %}
          </button>
          <button type="button" class="rec-carousel-btn rec-carousel-btn--next" data-rec-next aria-label="Next products">
            {% render 'icon', icon: 'arrow-right' %}
          </button>
        </div>
      </div>

      <div class="recommendations-carousel-track" data-rec-track>
        {%- for recommendation in recommendations.products -%}
          {%- unless recommendation.id == product.id -%}
            <div class="recommendations-carousel-item" data-rec-card>
              {% render 'product-card', product: recommendation %}
            </div>
          {%- endunless -%}
        {%- endfor -%}
      </div>
    </div>
  {%- else -%}
    {%- comment -%}
      Server-side / Theme Customizer fallback: Pull from primary collection or type to ensure editorial presence
    {%- endcomment -%}
    {%- liquid
      assign fallback_collection = collection | default: product.collections.first
      if fallback_collection == blank or fallback_collection.products_count < 2
        assign fallback_collection = collections.all
      endif
    -%}
    {%- if fallback_collection != blank and fallback_collection.products_count > 1 -%}
      <div class="container" data-rec-fallback-container>
        <div class="recommendations__header" data-recommendations-header>
          <div>
            <span class="recommendations__subheading">ARCHIVE SELECTION</span>
            <h2 class="recommendations__title">{{ section.settings.heading | default: 'YOU MAY ALSO LIKE' | upcase }}</h2>
          </div>
          <div class="recommendations__controls">
            <button type="button" class="rec-carousel-btn rec-carousel-btn--prev" data-rec-prev aria-label="Previous products">
              {% render 'icon', icon: 'arrow-left' %}
            </button>
            <button type="button" class="rec-carousel-btn rec-carousel-btn--next" data-rec-next aria-label="Next products">
              {% render 'icon', icon: 'arrow-right' %}
            </button>
          </div>
        </div>

        <div class="recommendations-carousel-track" data-rec-track>
          {%- assign rec_count = 0 -%}
          {%- for item in fallback_collection.products -%}
            {%- unless item.id == product.id -%}
              {%- if rec_count < 6 -%}
                <div class="recommendations-carousel-item" data-rec-card>
                  {% render 'product-card', product: item %}
                </div>
                {%- assign rec_count = rec_count | plus: 1 -%}
              {%- endif -%}
            {%- endunless -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  {%- endif -%}
</div>

<script>
  (function() {
    const sectionEl = document.querySelector('.product-recommendations[data-url]');
    if (!sectionEl) return;

    const initCarouselNav = (container) => {
      const track = container.querySelector('[data-rec-track]');
      const prevBtn = container.querySelector('[data-rec-prev]');
      const nextBtn = container.querySelector('[data-rec-next]');
      if (!track || !prevBtn || !nextBtn) return;

      prevBtn.addEventListener('click', () => {
        track.scrollBy({ left: -track.clientWidth * 0.75, behavior: 'smooth' });
      });

      nextBtn.addEventListener('click', () => {
        track.scrollBy({ left: track.clientWidth * 0.75, behavior: 'smooth' });
      });

      // Staggered reveal animation on viewport entry
      const cards = container.querySelectorAll('[data-rec-card]');
      if ('IntersectionObserver' in window && cards.length > 0) {
        const cardObserver = new IntersectionObserver((entries, obs) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              cards.forEach((card, i) => {
                setTimeout(() => {
                  card.classList.add('is-revealed');
                }, i * 90);
              });
              obs.disconnect();
            }
          });
        }, { threshold: 0.15 });
        cardObserver.observe(track);
      }
    };

    // Initialize immediate carousel if fallback container is rendered
    initCarouselNav(sectionEl);

    // Dynamic Shopify API fetch
    const handleIntersection = (entries, observer) => {
      if (!entries[0].isIntersecting) return;
      observer.unobserve(sectionEl);

      const url = sectionEl.dataset.url;
      if (!url) return;

      fetch(url)
        .then(response => {
          if (!response.ok) throw new Error('Network error');
          return response.text();
        })
        .then(text => {
          const parser = new DOMParser();
          const doc = parser.parseFromString(text, 'text/html');
          const recEl = doc.querySelector('.product-recommendations');

          if (recEl && recEl.querySelectorAll('.product-card').length > 0) {
            sectionEl.innerHTML = recEl.innerHTML;
            sectionEl.style.display = '';
            initCarouselNav(sectionEl);
          }
        })
        .catch(() => {
          // Keep existing fallback
        });
    };

    const observer = new IntersectionObserver(handleIntersection, { rootMargin: '0px 0px 300px 0px' });
    observer.observe(sectionEl);
  })();
</script>

{% schema %}
{
  "name": "Product Recommendations",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "YOU MAY ALSO LIKE"
    }
  ]
}
{% endschema %}
