{% comment %}
  Reusable product card snippet
  Usage: {% render 'product-card', product: product %}
{% endcomment %}
{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign fulfillment_meta = product.metafields.custom.fulfillment_type | downcase | strip
  assign is_digital = false
  assign is_bundle = false

  if fulfillment_meta == 'digital'
    assign is_digital = true
  elsif fulfillment_meta == 'bundle'
    assign is_bundle = true
  elsif fulfillment_meta == 'physical'
    assign is_digital = false
    assign is_bundle = false
  else
    # Backward-compatible fallback detection
    if product.type == 'Digital' or product.tags contains 'Digital' or product.tags contains 'digital'
      assign is_digital = true
    elsif product.type == 'Bundle' or product.tags contains 'Bundle' or product.tags contains 'bundle'
      assign is_bundle = true
    endif
  endif
-%}

<div class="product-card" data-product-id="{{ product.id }}">
  <div class="product-card__media-wrapper">
    <div class="product-card__badges">
      {% render 'badge', product: product %}
    </div>

    <a href="{{ product.url }}" class="product-card__link" aria-label="{{ product.title }}">
      {%- if product.featured_image != blank -%}
        <img
          src="{{ product.featured_image | image_url: width: 600 }}"
          alt="{{ product.featured_image.alt | default: product.title | escape }}"
          class="product-card__image"
          loading="lazy"
          width="600"
          height="750"
        >
        {%- if product.images[1] != blank -%}
          <img
            src="{{ product.images[1] | image_url: width: 600 }}"
            alt="{{ product.title | escape }}"
            class="product-card__image product-card__image--secondary"
            loading="lazy"
            width="600"
            height="750"
          >
        {%- endif -%}
      {%- else -%}
        <div style="width:100%; height:100%; display:flex; align-items:center; justify-content:center; background:#EAE7E1; color:#9E9A91; font-weight:600;">
          SEVOLF
        </div>
      {%- endif -%}
    </a>

    <div class="product-card__quick-add">
      {%- form 'product', product -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}">
        <button
          type="submit"
          class="btn btn--full btn--white"
          style="padding: 0.75rem 1rem; font-size: 0.78rem;"
          {% unless current_variant.available %}disabled{% endunless %}
        >
          {% if current_variant.available %}
            {% if is_digital %}
              Get Instant Access
            {% elsif is_bundle %}
              Get Bundle
            {% else %}
              Quick Add
            {% endif %}
          {% else %}
            Sold Out
          {% endif %}
        </button>
      {%- endform -%}
    </div>
  </div>

  <div class="product-card__content">
    <span class="product-card__type">{{ product.type | default: 'Collection' | upcase }}</span>
    <h3 class="product-card__title">
      <a href="{{ product.url }}">{{ product.title }}</a>
    </h3>
    <div class="product-card__price-row">
      <div class="product-card__price-item">
        {% render 'price', product: product %}
      </div>
      {%- if current_variant.available -%}
        {%- form 'product', product, class: 'product-card__plus-form' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}">
          <button type="submit" class="product-card__plus-btn" aria-label="Quick add {{ product.title }} to bag">
            {% render 'icon', icon: 'plus' %}
          </button>
        {%- endform -%}
      {%- endif -%}
    </div>
  </div>
</div>
